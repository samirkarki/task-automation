# =============================================================================
# NEPSE Faceless Automation & Monetization Infrastructure Configuration
# Copy this file to .env and configure your secrets
# =============================================================================

# 1. Ollama LLM Configuration (Local on YetiCloud Nvidia L4)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3-coder:30b

# 2. rclone Google Drive Remotes (Parent: TaskAutomation/)
RCLONE_DATA_REMOTE=gdrive:TaskAutomation/nepse/data/
RCLONE_NEPSE_REMOTE=gdrive:TaskAutomation/nepse/reports/
RCLONE_CONTENT_REMOTE=gdrive:TaskAutomation/faceless_content/
RCLONE_WARFARE_REMOTE=gdrive:TaskAutomation/narrative-warfare/

# 3. Text-to-Speech Settings (Human Neural Nepali Voices)
# Options: ne-NP-SagarNeural (Male, Authoritative), ne-NP-HemkalaNeural (Female, Articulate)
TTS_VOICE=ne-NP-SagarNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# 4. Telegram Community & Signal Monetization
# Get bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Public / Free Channel ID or @username (e.g., @NepseAlphaFree or -1001234567890)
TELEGRAM_FREE_CHANNEL_ID=@your_free_channel
# Private VIP Paid Signal Channel ID (e.g., -1009876543210)
TELEGRAM_VIP_CHANNEL_ID=@your_vip_channel
# Link to join the free channel (promoted on YouTube descriptions)
TELEGRAM_FREE_INVITE_LINK=https://t.me/your_channel_invite

# 5. YouTube Shorts Auto-Publisher (Google Cloud Console OAuth2)
# Path to client_secrets.json downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secrets.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_PRIVACY_STATUS=public

# 6. Affiliate & Monetization Links (included in video descriptions)
AFFILIATE_BROKER_LINK=https://nepsetms.com/referral
AFFILIATE_BOOK_LINK=https://amzn.to/example
PAYMENT_ESEWA_ID=98XXXXXXXX
PAYMENT_KHALTI_ID=98XXXXXXXX

# 7. Pluggable Visual Media Configuration
# Priority order of providers to try (comma-separated):
# Options: pixabay, local_sdxl, comfyui, pexels, wikimedia, procedural
VISUAL_PROVIDERS=pixabay,local_sdxl,pexels,wikimedia,procedural

# Pixabay API (Recommended Free Live-Action Stock Videos & Photos)
# Instant free API key from https://pixabay.com/api/docs/ (no approval needed)
PIXABAY_API_KEY=

# Local SDXL Turbo (PyTorch + Diffusers on Nvidia L4 GPU)
# Set to 'false' to disable local GPU image generation
ENABLE_LOCAL_SDXL=true

# ComfyUI Endpoint (Optional)
# Set when running ComfyUI on localhost or remote server (defaults to http://0.0.0.0:8188/)
COMFYUI_URL=http://0.0.0.0:8188/

# Pexels API (Optional - if you have an existing key)
PEXELS_API_KEY=

# =============================================================================
# 8. Autonomous YouTube Shorts Clipping & Monetization Engine
# =============================================================================
# Your Bridge Page URL (Beacons.ai, Stan.store, Carrd, or Linktree)
# Point all your affiliate offers, SaaS links, and digital templates here.
BRIDGE_PAGE_URL=https://beacons.ai/samctec

# Direct Affiliate Links (optional overrides)
AFFILIATE_TOOLS_LINK=https://beacons.ai/samctec
AFFILIATE_BOOKS_LINK=https://amzn.to/yourlist
NEWSLETTER_SIGNUP_LINK=https://yourname.substack.com

# Schedule & Upload Settings
CLIPS_PER_DAY=3
RCLONE_CLIPS_REMOTE=gdrive:TaskAutomation/clips-output/

# Model Settings
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cuda

# --- Instagram Reels (Meta Graph API) ---
# Requires Instagram Professional/Creator account connected to Facebook Page
# Leave blank to skip Instagram upload
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- TikTok Video Upload (TikTok Content Posting API v2) ---
# Requires TikTok Developer Portal access token
# Leave blank to skip TikTok upload
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
